{
  "name": "faceframe",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run verify:assets && npm run verify:catalog && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --experimental-strip-types tests/unit.test.ts tests/geometry.test.ts tests/recommendations.test.ts tests/report.test.ts",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
